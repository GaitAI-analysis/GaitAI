# Template only — copy to .env.local and fill in real values.
# .env.local is gitignored; NEVER commit real keys to this file.

# Override the admin password for the /admin route.
# If not set, the default password is "gaitai-admin".
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Firebase Client SDK — REQUIRED. Get these from Firebase Console:
# Project settings -> General -> Your apps -> SDK setup and configuration
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Abuse protection — optional Cloudflare Turnstile (CAPTCHA). Leave the site key
# blank to keep the CAPTCHA gate disabled (the widget is pluggable/toggleable).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# ASK GAITAI — the assistant's backend endpoint.
#
# This is a URL, not a secret: the model API key lives ONLY in Google Secret
# Manager and is read inside the Cloud Function. Nothing about the model
# provider or the credential is ever exposed to the browser.
#
# Leave blank and the assistant does not mount at all — the site renders
# exactly as it did before. Set it to the deployed function URL:
#   https://asia-south1-gaitai-intelligence.cloudfunctions.net/askGaitai
# or, against the local emulator:
#   http://127.0.0.1:5001/gaitai-intelligence/asia-south1/askGaitai
#
# See docs/ask-gaitai.md.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ASK_GAITAI_ENDPOINT=
