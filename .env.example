# Template only — copy to .env.local and fill in real values.
# .env.local is gitignored; NEVER commit real keys to this file.

# Override the admin password for the /admin route.
# If not set, the default password is "gaitai-admin".
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Firebase Client SDK — REQUIRED. Get these from Firebase Console:
# Project settings -> General -> Your apps -> SDK setup and configuration
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Abuse protection — optional Cloudflare Turnstile (CAPTCHA). Leave the site key
# blank to keep the CAPTCHA gate disabled (the widget is pluggable/toggleable).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# ASK GAITAI — nothing REQUIRED here, and one thing that must NEVER be here.
#
# Retrieval runs in the visitor's browser over the generated corpus. Prose is
# written by a hosted model behind a Cloudflare Worker (worker/) that calls the
# Google Gemini Developer API (Free Tier). Firebase is not involved.
#
# The PUBLIC Worker URL. Leave it empty and the assistant makes no network
# request at all — every answer is the local extractive one. Set it to the
# deployed Worker to switch hosted answers on. It contains no secret.
NEXT_PUBLIC_ASK_GAITAI_ENDPOINT=
# e.g. https://ask.gaitai.in/api/ask
#
# The Gemini API key is a CLOUDFLARE WORKER SECRET named GEMINI_API_KEY, set
# with `wrangler secret put GEMINI_API_KEY` from worker/ (or worker/.dev.vars
# for local development — see worker/.dev.vars.example). It must never appear
# in this file, in any NEXT_PUBLIC_ variable, in the repository, or in the
# browser. For the local benchmark, export it in the shell for that one command.
#
#   npm run build:knowledge   regenerate the corpus (runs in predev/prebuild)
#   npm run ask:test          the 25-question suite, no model, no network
#   npm run ask:rank          the ranking/intent suite, no model, no network
#   npm run ask:bench         score hosted models on the site's own questions
#   npm run worker:test       the Worker's tests, provider mocked
