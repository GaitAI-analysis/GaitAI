# Override the admin password for the /admin route.
# If not set, the default password is "gaitai-admin".
ADMIN_PASSWORD=gaitai-admin

# ---------------------------------------------------------------------------
# Firebase Client SDK (public client keys — safe to ship in the static bundle).
# All values are optional: src/lib/firebase.ts ships working defaults for the
# gaitai-33c7f project, but set these to point the comment system at another
# Firebase project/environment without touching code.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBvQFrPJPgGkizJC-loZjeEIZemAKA-eYw
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=gaitai-33c7f.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=gaitai-33c7f
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=gaitai-33c7f.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=52857173308
NEXT_PUBLIC_FIREBASE_APP_ID=1:52857173308:web:9ecefc164e3f6eea91da39

# Abuse protection — optional Cloudflare Turnstile (CAPTCHA). Leave the site key
# blank to keep the CAPTCHA gate disabled (the widget is pluggable/toggleable).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
