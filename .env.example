# Template only — copy to .env.local and fill in real values.
# .env.local is gitignored; NEVER commit real keys to this file.

# Override the admin password for the /admin route.
# If not set, the default password is "gaitai-admin".
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Firebase Client SDK — REQUIRED. Get these from Firebase Console:
# Project settings -> General -> Your apps -> SDK setup and configuration
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Abuse protection — optional Cloudflare Turnstile (CAPTCHA). Leave the site key
# blank to keep the CAPTCHA gate disabled (the widget is pluggable/toggleable).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# ASK GAITAI needs nothing here.
#
# Retrieval and generation both run in the visitor's browser — a BM25 index
# over the generated 113-record corpus, and an Apache-2.0 open-weight model
# loaded on demand through Transformers.js. There is no endpoint, no API key,
# no Cloud Function and no billing account, so there is no variable to set and
# nothing that can be left unset by accident.
#
#   npm run build:knowledge   regenerate the corpus (runs in predev/prebuild)
#   npm run ask:test          the 25-question suite, no model, no network
#   npm run ask:bench         score a candidate model on those 25 questions
