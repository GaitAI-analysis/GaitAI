# Template only — copy to .env.local and fill in real values.
# .env.local is gitignored; NEVER commit real keys to this file.

# Override the admin password for the /admin route.
# If not set, the default password is "gaitai-admin".
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Firebase Client SDK — REQUIRED. Get these from Firebase Console:
# Project settings -> General -> Your apps -> SDK setup and configuration
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Abuse protection — optional Cloudflare Turnstile (CAPTCHA). Leave the site key
# blank to keep the CAPTCHA gate disabled (the widget is pluggable/toggleable).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# ASK GAITAI — nothing REQUIRED here, and one thing that must NEVER be here.
#
# Retrieval runs in the visitor's browser over the generated corpus. Prose is
# written by a hosted model behind the project's own Cloud Function
# (`askGaitai`, in functions/), which calls Hugging Face Inference Providers.
#
# The function URL is a build-time default in src/components/assistant/config.ts.
# Override it only to point a build at an emulator or a staging project, or set
# it to an empty string to run retrieval-only (the extractive answer):
# NEXT_PUBLIC_ASK_GAITAI_ENDPOINT=
#
# The Hugging Face token is a SERVER secret in Google Secret Manager:
#   npx -y firebase-tools@13 functions:secrets:set HF_TOKEN
# It must never appear in this file, in any NEXT_PUBLIC_ variable, in the
# repository, or in the browser. For the local benchmark and the function's
# local harness, export it in the shell for that one command:
#   HF_TOKEN=hf_… npm run ask:bench
#   HF_TOKEN=hf_… npm run functions:test
#
#   npm run build:knowledge   regenerate the corpus (runs in predev/prebuild)
#   npm run ask:test          the 25-question suite, no model, no network
#   npm run ask:rank          the ranking/intent suite, no model, no network
#   npm run ask:bench         score hosted models on the site's own questions
