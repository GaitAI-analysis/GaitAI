# The Ask GaitAI Cloud Function's build output, and the two things its build
# step copies in from the site so there is exactly one retrieval implementation
# and exactly one corpus (functions/scripts/sync-shared.mjs):
#   functions/src/shared/   ← src/lib/ask/*.ts
#   functions/knowledge.json ← public/ask/knowledge.json
functions/lib
functions/src/shared
functions/knowledge.json
out
