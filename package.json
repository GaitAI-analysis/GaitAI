{
  "name": "gaitai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:firebase": "node scripts/test-firebase.mjs",
    "predev": "node scripts/generate-firebase-config.mjs && node scripts/sync-posts.mjs && npm run build:knowledge",
    "prebuild": "node scripts/generate-firebase-config.mjs && node scripts/sync-posts.mjs && npm run validate:gaitai && npm run build:knowledge",
    "typecheck": "tsc --noEmit",
    "validate:gaitai": "tsx scripts/validate-gaitai.mjs",
    "rules:login": "npx -y firebase-tools@13 login",
    "rules:whoami": "npx -y firebase-tools@13 login:list && npx -y firebase-tools@13 projects:list",
    "deploy:rules": "npx -y firebase-tools@13 deploy --only firestore:rules",
    "journal:doctor": "tsx scripts/journal-doctor.mjs",
    "site:doctor": "node scripts/site-doctor.mjs",
    "verify": "npm run typecheck && npm run lint && npm run validate:gaitai && npm run ask:test && npm run ask:rank",
    "check:links": "node scripts/check-links.mjs",
    "build:knowledge": "tsx scripts/build-knowledge.mjs",
    "ask:test": "tsx scripts/ask-test.ts",
    "ask:rank": "tsx scripts/ask-ranking-test.ts",
    "ask:bench": "tsx scripts/ask-bench.ts",
    "test:insights": "tsx scripts/test-insights-scaling.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "clsx": "^2.1.1",
    "firebase": "^12.15.0",
    "framer-motion": "^11.3.31",
    "lucide-react": "^0.460.0",
    "next": "14.2.18",
    "next-themes": "^0.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.18",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.13",
    "typescript": "5.9.3"
  }
}
