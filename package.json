{
  "name": "gaitai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:firebase": "node scripts/test-firebase.mjs",
    "predev": "node scripts/generate-firebase-config.mjs && node scripts/sync-posts.mjs",
    "prebuild": "node scripts/generate-firebase-config.mjs && node scripts/sync-posts.mjs && npm run validate:gaitai",
    "typecheck": "tsc --noEmit",
    "validate:gaitai": "tsx scripts/validate-gaitai.mjs",
    "verify": "npm run typecheck && npm run lint && npm run validate:gaitai",
    "check:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "clsx": "^2.1.1",
    "firebase": "^12.15.0",
    "framer-motion": "^11.3.31",
    "lucide-react": "^0.460.0",
    "next": "14.2.18",
    "next-themes": "^0.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.18",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3"
  }
}
