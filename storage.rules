rules_version = '2';

// GaitAI Insights media. Public readers can view published media, but only the
// same verified admin allowlist used by firestore.rules can mutate files.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && hashing.sha256(request.auth.token.email).toHexString() in [
             'be06df14191adca9f7f6f32bb2cdd785492c78ee3f54af70b0a6c41f821471cc',
             '5349769a9c56901f9007f7c6591ad46764720a1e9c5a824189ce81c816e415fb'
           ];
    }

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif|avif)');
    }

    function isVideo() {
      return request.resource.contentType.matches('video/(mp4|webm)');
    }

    function isDocument() {
      return request.resource.contentType in [
        'application/pdf',
        'text/markdown',
        'text/plain',
        'text/csv',
        'application/msword',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
        'application/vnd.ms-powerpoint',
        'application/vnd.openxmlformats-officedocument.presentationml.presentation',
        'application/vnd.ms-excel',
        'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
      ];
    }

    match /insights/posts/{postId}/cover/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && isImage();
      allow delete: if isAdmin();
    }

    match /insights/posts/{postId}/images/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && isImage();
      allow delete: if isAdmin();
    }

    match /insights/posts/{postId}/videos/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size > 0
        && request.resource.size <= 100 * 1024 * 1024
        && isVideo();
      allow delete: if isAdmin();
    }

    match /insights/posts/{postId}/documents/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024
        && isDocument();
      allow delete: if isAdmin();
    }
  }
}
