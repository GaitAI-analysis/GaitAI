# Copy to worker/.dev.vars for `wrangler dev`. .dev.vars is gitignored.
# No secret is needed: Workers AI is reached through the AI binding, and the
# model id is a plain var in wrangler.jsonc (WORKERS_AI_MODEL).
#
# Local site origins to accept during development (the production list lives
# in wrangler.jsonc and is not used when this is set).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://gaitai.in

# Print one readable block per question to the wrangler dev console: the
# question, selected/resolved record ids and titles, provider, model, status
# and latency. LOCAL ONLY — never set this on the deployed Worker.
ASK_DEBUG=1
